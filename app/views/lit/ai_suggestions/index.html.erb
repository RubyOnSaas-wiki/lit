<h3><%= I18n.t('lit.ai_suggestions.header', default: 'AI translated') %></h3>

<div class="ai-intro">
  <p>
    <strong>Nothing here is live yet.</strong>
    Until you accept a proposal the application keeps serving the <em>Current value</em>,
    and the <em>Translate!</em> tab is unchanged.
  </p>
  <details>
    <summary>How this works</summary>
    <ul>
      <li><strong>Current value</strong> is what the application serves right now. If somebody edits it in <em>Translate!</em>, it changes here too.</li>
      <li><strong>Proposal</strong> is what the AI suggests. You can edit it before accepting.</li>
      <li><strong>Accept</strong> writes the proposal into the translations, marks it ready for synchronization, and removes it from this tab.</li>
      <li><strong>Reject</strong> deletes the proposal and changes no translation.</li>
      <li><strong>Tags</strong> are the features a key was introduced for. The filter lists only tags present on this tab.</li>
    </ul>
  </details>
</div>

<%= render 'filters' %>

<% if @ai_suggestions.to_a.empty? %>
  <p class="ai-empty">No AI proposals are waiting.</p>
<% else %>
  <table class="table ai-table">
    <thead>
      <tr>
        <th class="ai-locale">Locale</th>
        <th class="ai-current">Current value</th>
        <th class="ai-proposal">Proposal</th>
        <th class="ai-actions">Actions</th>
      </tr>
    </thead>
    <% @ai_suggestions.group_by(&:localization_key).each do |localization_key, suggestions| %>
      <tbody class="ai-group">
        <tr class="ai-key-row">
          <td colspan="4">
            <span class="ai-key"><%= localization_key.localization_key %></span>
            <i class="fa fa-clipboard js-copy_to_clipboard copy_to_clipboard_button"
               title="Copy key" data-key="<%= localization_key.localization_key %>"></i>
            <% localization_key.tags.each do |tag| %>
              <%= link_to tag.name, lit.ai_suggestions_path(@search_options.to_hash.merge('tags' => [tag.name])),
                          class: 'ai-tag', title: "Filter by #{tag.name}" %>
            <% end %>
          </td>
        </tr>
        <% suggestions.each do |suggestion| %>
          <%= render 'suggestion', suggestion: suggestion %>
        <% end %>
      </tbody>
    <% end %>
  </table>

  <% if defined?(Kaminari) && @ai_suggestions.respond_to?(:current_page) %>
    <%= paginate @ai_suggestions, theme: 'lit' %>
  <% elsif defined?(WillPaginate) && @ai_suggestions.respond_to?(:total_pages) %>
    <%= will_paginate @ai_suggestions %>
  <% end %>
<% end %>
